<Window x:Class="TestDbHub.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TestDbHub.Wpf.ViewModels"
        Title="TestDB Hub — MySQL + HeliosDB-Nano"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TestDB Hub" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="MySQL + HeliosDB-Nano" Foreground="{StaticResource MutedBrush}" Margin="8,0,24,0" VerticalAlignment="Center" />
                    <Button Content="⟳ Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,0" />
                    <Button Content="+ Database" Command="{Binding NewDatabaseCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,0"
                            ToolTip="Tạo database test mới trên MySQL" />
                    <Button Content="⚙ Kết nối" Command="{Binding OpenSettingsCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="120" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Engines / databases / branches -->
            <TreeView Grid.Column="0" ItemsSource="{Binding Engines}" BorderThickness="0" Padding="4"
                      SelectedItemChanged="OnTreeSelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                        <Setter Property="Padding" Value="2,3" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:TreeNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" Width="20" />
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding Badge}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       Margin="8,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <!-- Empty state -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                        Visibility="{Binding NoContext, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Chọn một database hoặc nhánh bên trái" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"
                           Text="Mỗi database có nhánh main. Tạo nhánh để thử nghiệm mà không ảnh hưởng dữ liệu gốc, chụp snapshot để khôi phục sau, hoặc sao chép bảng giữa MySQL và HeliosDB-Nano. Bấm ⚙ Kết nối để nhập thông tin máy chủ." />
            </StackPanel>

            <!-- Workspace -->
            <Grid Grid.Column="2" Margin="12,10,12,8"
                  Visibility="{Binding HasContext, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="120" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="3*" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- Context + actions -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ContextEngine}" Foreground="{Binding ContextBrush}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="  ›  " Foreground="{StaticResource MutedBrush}" FontSize="16" />
                        <TextBlock Text="{Binding ContextPath}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="⑂ Tạo nhánh" Command="{Binding CreateBranchCommand}" Style="{StaticResource ActionButton}" />
                        <Button Content="📸 Snapshot" Command="{Binding CreateSnapshotCommand}" Style="{StaticResource ActionButton}"
                                Visibility="{Binding CanSnapshot, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="🕒 Time-travel" Command="{Binding TimeTravelCommand}" Style="{StaticResource ActionButton}"
                                Visibility="{Binding CanTimeTravel, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{Binding MergeLabel}" Command="{Binding MergeCommand}" Style="{StaticResource ActionButton}"
                                Visibility="{Binding CanMerge, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="⇄ Sao chép sang..." Command="{Binding CopyTablesCommand}" Style="{StaticResource ActionButton}" />
                        <Button Content="⬇ Xuất .sql" Command="{Binding ExportSqlCommand}" Style="{StaticResource ActionButton}" />
                        <Button Content="✕ Xoá nhánh" Command="{Binding DropBranchCommand}" Style="{StaticResource DangerButton}"
                                Visibility="{Binding CanDropBranch, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="✕ Xoá database" Command="{Binding DropDatabaseCommand}" Style="{StaticResource DangerButton}"
                                Visibility="{Binding CanDropDatabase, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </StackPanel>

                <!-- Tables -->
                <DockPanel Grid.Row="1" Margin="0,2,0,8">
                    <TextBlock Text="Bảng:" Foreground="{StaticResource MutedBrush}" Margin="0,4,8,0" DockPanel.Dock="Left" />
                    <StackPanel>
                        <TextBlock Text="{Binding TablesHint}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding Tables}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.PreviewTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Padding="10,2" Margin="0,0,6,6"
                                            ToolTip="Bấm: xem dữ liệu · Shift + bấm: xem cấu trúc">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding ApproxRows, StringFormat=' ~{0}', TargetNullValue=''}" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>

                <!-- SQL editor -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,8,8,2">
                            <WrapPanel>
                                <Button Content="▶ Chạy (Ctrl+Enter)" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="Dữ liệu mẫu" Command="{Binding LoadSampleCommand}" Style="{StaticResource ActionButton}" />
                                <Button Content="Mở file .sql" Command="{Binding OpenSqlFileCommand}" Style="{StaticResource ActionButton}" />
                            </WrapPanel>
                        </Border>
                        <TextBox Text="{Binding SqlText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource CodeFont}" FontSize="13" Padding="8" BorderThickness="0"
                                 Background="#F7F8FA">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Modifiers="Control" Command="{Binding RunCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Results -->
                <TabControl Grid.Row="4" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ResultViewModel}">
                            <TextBlock x:Name="Header" Text="{Binding Header}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter TargetName="Header" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:ResultViewModel}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="2,2,2,6">
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding Sql}" FontFamily="{StaticResource CodeFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sql}" />
                                </DockPanel>
                                <Grid>
                                    <DataGrid ItemsSource="{Binding Grid}" AutoGenerateColumns="True" IsReadOnly="True"
                                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource BorderBrush}" MaxColumnWidth="420"
                                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                              AutoGeneratingColumn="OnAutoGeneratingColumn"
                                              Visibility="{Binding HasGrid, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                             Padding="4" FontFamily="{StaticResource CodeFont}" Background="Transparent"
                                             Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </DockPanel>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
